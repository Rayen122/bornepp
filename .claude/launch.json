{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "metro",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--dev-client",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "api",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "backend/artisan",
        "serve",
        "--host=0.0.0.0",
        "--port=8000"
      ],
      "port": 8000
    },
    {
      "name": "ocpp",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "ocpp-server",
        "start"
      ],
      "port": 9222
    },
    {
      "name": "backoffice",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backoffice",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173,
      "env": {
        "API_URL": "http://localhost:8000"
      }
    }
  ]
}
